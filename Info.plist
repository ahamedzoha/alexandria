<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Self-hosted servers are often plain http:// on a LAN. Scope the ATS
		     exception to local networking (raw IPs, .local, unqualified names)
		     instead of disabling ATS globally; https to the internet stays
		     enforced. Plain http to a fully-qualified public hostname is
		     intentionally NOT allowed — use https (reverse proxy) for that. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Sparkle auto-updates: the appcast is attached to every GitHub release,
	     and `latest/download` always serves the newest one. Updates are
	     EdDSA-signed by Scripts/package.sh (private key in the login Keychain;
	     generated by Sparkle's generate_keys). -->
	<key>SUFeedURL</key>
	<string>https://github.com/ahamedzoha/alexandria/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>XxVI3wBKcScuTYaxVooOgVc/R2AJyjDGmVTh1JOP2CI=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- The app is sandboxed, so Sparkle cannot spawn its installer from the
	     app process — it must go through the Installer XPC service bundled in
	     Sparkle.framework. Without this the update downloads, then fails with
	     "An error occurred while launching the installer." The Downloader XPC
	     service is deliberately NOT enabled: the app already holds the
	     network.client entitlement. -->
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<!-- Books and episodes dragged onto Up Next carry this type. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.alexandria.mac.queue-entry</string>
			<key>UTTypeDescription</key>
			<string>Alexandria Up Next Item</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
